{
  "name": "parallel-tech-store",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test:catalogue": "node --test tests/catalogue.test.mjs",
    "db:generate": "drizzle-kit generate",
