    "db:seed": "node --conditions=react-server --import tsx scripts/seed.ts",
    "test:backend": "node --conditions=react-server --import tsx --test tests/backend.test.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "0.10.4",
    "better-auth": "^1.7.12",
