    "lucide-react": "0.468.0",
    "next": "^16.4.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "22.10.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/ws": "^8.18.2",
    "autoprefixer": "10.4.20",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.17.0",
    "eslint-config-next": "^16.4.3",
